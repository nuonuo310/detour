{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "detour-music-room",
  "main": "cloudflare/music-room-worker.js",
  "compatibility_date": "2026-08-28",
  "durable_objects": {
    "bindings": [
      {
        "name": "MUSIC_ROOM",
        "class_name": "MusicRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MusicRoom"]
    }
  ]
}
